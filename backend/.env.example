# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/subsguard

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-change-this-now
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=another-super-secret-key-min-32-chars-change-this-now
REFRESH_TOKEN_EXPIRES_IN=7d

# Email (Resend) - będzie później
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@subsguard.com

# Stripe - będzie później
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# CORS
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:3000
